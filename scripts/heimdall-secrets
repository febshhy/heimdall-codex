#!/usr/bin/env python3
"""Manage ONLY non-secret credential metadata for Heimdall projects.

This tool intentionally never prompts for, reads, or stores secret values.
Use an operator-side vault/proxy in a separate security boundary for values.
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

NAME = re.compile(r'^[A-Z][A-Z0-9_]{1,79}$')
REGISTRY = '.heimdall/credential-names.json'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', default='.')
    subs = parser.add_subparsers(dest='command', required=True)
    subs.add_parser('list')
    add = subs.add_parser('add')
    add.add_argument('name')
    add.add_argument('--scope', required=True, choices=('read-only','write-needs-approval'))
    add.add_argument('--provider', required=True, choices=('external-vault','host-proxy','manual-operator'))
    add.add_argument('--write', action='store_true')
    args = parser.parse_args()
    root = Path(args.project).resolve(strict=True)
    if Path(subprocess.check_output(['git', '-C', str(root), 'rev-parse', '--show-toplevel'], text=True).strip()).resolve() != root:
        parser.error('project must be Git worktree root')
    if (root / '.heimdall').is_symlink() or (root / REGISTRY).is_symlink():
        parser.error('symlink in credential registry path')
    path = root / REGISTRY
    data = json.loads(path.read_text(encoding='utf8')) if path.exists() else {'schema': 1, 'credentials': []}
    if (data.get('schema') != 1 or not isinstance(data.get('credentials'), list)):
        parser.error('unrecognized registry schema')
    if args.command == 'list':
        for item in data['credentials']:
            print(f"{item['name']} ({item['provider']}, {item['scope']})")
        return
    if not NAME.fullmatch(args.name):
        parser.error('name must be an uppercase environment-variable identifier')
    if any(item['name'] == args.name for item in data['credentials']):
        parser.error('name already registered; manual review required')
    record = {'name': args.name, 'scope': args.scope, 'provider': args.provider}
    print(f"Credential metadata preview: {record['name']} / {record['provider']} / {record['scope']}")
    if not args.write:
        print('Preview only. Use --write to record the name; never paste credential values.')
        return
    data['credentials'].append(record)
    data['credentials'].sort(key=lambda r: r['name'])
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(data, indent=2, sort_keys=True) + '\n'
    if path.exists():
        # Never overwrite unrecognized content; use atomic replace after parsing.
        import tempfile
        fd, candidate = tempfile.mkstemp(prefix='.credential-names.', dir=path.parent)
        try:
            with os.fdopen(fd, 'w') as fp:
                fp.write(payload)
            os.chmod(candidate, 0o600)
            os.replace(candidate, path)
        finally:
            Path(candidate).unlink(missing_ok=True)
    else:
        with path.open('x') as fp:
            fp.write(payload)
        os.chmod(path, 0o600)
    print('Recorded credential NAME only. Enter the real value into your operator-side vault, outside the Codex environment.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError, TypeError) as e:
        print('Heimdall credentials: ' + str(e), file=sys.stderr)
        sys.exit(2)
